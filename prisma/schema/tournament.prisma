model Tournament {
  tournamentId           String                  @id @default(uuid())
  name                   String
  gameTitle              String
  gameType               TournamentGameType        @default(OTHER)
  tournamentFormat       TournamentFormat
  numberOfTeams          Int
  entryFee               Float
  currency               Currency
  paymentWindow          Int
  prizeRule              PrizeRule
  percentage             Float?
  houseRake              Float?
  couponCreation         Boolean                 @default(false)
  registrationCutOffMode RegistrationCutOffMode?
  startDate              DateTime
  deadline               DateTime
  capacity               Int
  dailyStart             String
  dailyEnd               String
  matchDuration          Int
  turnoverDuration       Int
  lunchBreakTime         String?
  lunchDuration          Int?
  buffer                 Int
  frequencyStatus        FrequencyStatus
  frequencyArray         String[]
  canvasImage            String?
  playerOrgUrl           String?
  prOrgUrl               String?
  tournamentLogoUrl      String?
  rules                  String[]
  tsAndTc                String[]
  schedulingMode         SchedulingMode          @default(MANUAL)
  schedule               Json?
  status                 TournamentStatus        @default(UPCOMING)
  registrationOpen       Boolean                 @default(false)
  requireJerseySize      Boolean                 @default(false)
  schedulingPaused       Boolean                 @default(false)
  playerCardTemplate     Json?
  fanPassTemplate        Json?
  isDeleted              Boolean                 @default(false)
  version                Int                     @default(1)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  manageEventCosts  ManageEventCost[]
  manageEventPrizes ManageEventPrize[]
  venues            Venue[]
  sponsors          Sponsor[]
  registrations     TournamentRegistration[]
  raffles           Raffle[]
  seriesTournaments SeriesTournament[]
  tickets           Ticket[]
  ticketTiers       TicketTier[]
  payments          Payment[]
  fanApplications   FanTournamentApplication[]
  predictions       FanPrediction[]
  guidelines        TournamentGuideline[]
  staffAssignments  TournamentStaffAssignment[]
}

model TournamentStaffAssignment {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)
  matchId      String
  assignedAt   DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, matchId])
  @@index([employeeId, tournamentId])
}

/// Structured rules, terms, and policy content for a tournament.
/// The legacy Tournament.rules and Tournament.tsAndTc arrays remain temporarily
/// for backwards compatibility and can be removed after data migration.
model TournamentGuideline {
  id                    String                       @id @default(uuid())
  tournamentId          String
  tournament            Tournament                   @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  key                   String
  section               TournamentGuidelineSection
  type                  TournamentGuidelineType
  audience              TournamentGuidelineAudience @default(ALL)
  title                 String
  content               String?
  storageKey            String?
  externalUrl           String?
  fileName              String?
  mimeType              String?
  sortOrder             Int                          @default(0)
  version               Int                          @default(1)
  effectiveAt           DateTime?
  requiresAcceptance    Boolean                      @default(false)
  isPublished            Boolean                      @default(true)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@unique([tournamentId, section, key])
  @@index([tournamentId, section, isPublished, sortOrder])
}

enum TournamentGuidelineSection {
  RULES
  TERMS
  POLICY
}

enum TournamentGuidelineType {
  TEXT
  FILE
  LINK
}

enum TournamentGuidelineAudience {
  PLAYER
  SPECTATOR
  ALL
}

model ManageEventCost {
  manageEventCostId String      @id @default(uuid())
  costCategory      String
  amount            Float
  tournamentId      String?
  tournament        Tournament? @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model ManageEventPrize {
  manageEventPrizeId String      @id @default(uuid())
  prizeCategory      String
  amount             Float
  tournamentId       String?
  tournament         Tournament? @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Venue {
  venueId         String                     @id @default(uuid())
  name            String
  address         String
  tournamentId    String?
  tournament      Tournament?                @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  screens         Screen[]
  fanApplications FanTournamentApplication[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
}

model Screen {
  screenId   String     @id @default(uuid())
  screenName String
  venueId    String?
  venue      Venue?     @relation(fields: [venueId], references: [venueId], onDelete: Cascade)
  schedules  Schedule[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Schedule {
  scheduleId String   @id @default(uuid())
  screenId   String?
  screen     Screen?  @relation(fields: [screenId], references: [screenId], onDelete: Cascade)
  fanId      String?
  fan        Fan?     @relation(fields: [fanId], references: [fanId], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Sponsor {
  sponsorId    String        @id @default(uuid())
  name         String
  logo         String?
  website      String?
  priority     String?
  contact      String?
  value        Float?
  status       SponsorStatus @default(BOTH)
  tournamentId String?
  tournament   Tournament?   @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum SponsorStatus {
  BOTH
  PLAYER
  FAN
}

enum TournamentFormat {
  LEAGUE
  LEAGUE_DOUBLE
  LEAGUE_AND_KNOCKOUT
  LEAGUE_AND_KNOCKOUT_DOUBLE
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
}

enum Currency {
  USD
  GBP
  NGN
}

enum PrizeRule {
  PERCENTAGE
  FIXED_AMOUNT
}

enum RegistrationCutOffMode {
  DEADLINE
  CAPACITY
  BOTH
  MANUAL
}

enum FrequencyStatus {
  DAILY
  WEEKLY
  MONTHLY
}

enum TournamentStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  REGISTRATION_OPEN
  IN_PROGRESS
  PAUSED
  ARCHIVED
}

enum SchedulingMode {
  MANUAL
  AUTO_HOME_VENUE
  PLAYER_SELF
  AUTO_RANDOM
}

model TournamentRegistration {
  registrationId   String                       @id @default(uuid())
  tournamentId     String
  tournament       Tournament                   @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  playerId         String
  player           Player                       @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  fanApplicationId String?                      @unique
  fanApplication   FanTournamentApplication?    @relation(fields: [fanApplicationId], references: [id], onDelete: SetNull)
  homeVenueId      String?
  primaryTeamId    String?
  secondaryTeamId  String?
  status           TournamentRegistrationStatus @default(REGISTERED)
  paymentStatus    String                       @default("PENDING")
  paymentDeadline  DateTime?
  assignedSlot     Int?
  jerseySize       String?
  playerPhotoUrl   String?
  qrCodeString     String?
  checkedInVenue   Boolean                      @default(false)
  version          Int                          @default(1)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([tournamentId, playerId])
}

model FanTournamentApplication {
  id               String                         @id @default(uuid())
  fanId            String
  fan              Fan                            @relation(fields: [fanId], references: [fanId], onDelete: Restrict)
  tournamentId     String
  tournament       Tournament                     @relation(fields: [tournamentId], references: [tournamentId], onDelete: Restrict)
  homeVenueId      String?
  homeVenue        Venue?                         @relation(fields: [homeVenueId], references: [venueId], onDelete: SetNull)
  primaryTeamId    String?
  secondaryTeamId  String?
  jerseySize       String?
  status           FanTournamentApplicationStatus @default(PENDING_PAYMENT)
  playerId         String?
  player           Player?                        @relation(fields: [playerId], references: [playerId], onDelete: SetNull)
  payments         Payment[]
  registration     TournamentRegistration?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@unique([fanId, tournamentId])
  @@index([tournamentId, status])
  @@index([fanId, status])
}

enum FanTournamentApplicationStatus {
  PENDING_PAYMENT
  COMPLETED
  CANCELLED
}

enum TournamentGameType {
  FOOTBALL
  OTHER
}

model Payment {
  id               String                   @id @default(uuid())
  applicationId    String?
  application      FanTournamentApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tournamentId     String?
  tournament       Tournament?              @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  purchaserId      String?
  purchaserRole    String?
  ticketTierId     String?
  quantity         Int                      @default(1)
  seatNumber       String?
  purpose          String?
  gateway          String
  status           String                   @default("PENDING")
  amount           Float
  currency         Currency
  txRef            String?                  @unique
  flwTransactionId String?                  @unique
  checkoutUrl      String?
  paidAmount       Float?
  paidCurrency     Currency?
  paidAt           DateTime?
  providerDetails  Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([applicationId, status])
  @@index([tournamentId, status])
  @@index([purchaserId, status])
  @@index([gateway, status])
}

enum TournamentRegistrationStatus {
  REGISTERED
  SELECTED_UNPAID
  CONFIRMED
  WAITLISTED
  CANCELLED
}

model Raffle {
  raffleId              String       @id @default(uuid())
  tournamentId          String
  tournament            Tournament   @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  name                  String
  prizeDescription      String
  numberOfWinners       Int          @default(1)
  status                RaffleStatus @default(OPEN)
  drawDate              DateTime?
  registrationCloseDate DateTime?
  entries               Json?        @default("[]")
  winners               Json?        @default("[]")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

enum RaffleStatus {
  OPEN
  CLOSED
  DRAWN
  CANCELLED
}

model MatchDispute {
  disputeId    String        @id @default(uuid())
  matchId      String
  tournamentId String?
  reason       String
  notes        String?
  reportedBy   String?
  reportedByRole String?
  reportedByName String?
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?
  resolvedBy   String?
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tournamentId, matchId, status])
  @@index([status, createdAt])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}
