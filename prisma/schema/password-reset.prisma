model PasswordResetCode {
  passwordResetCodeId String    @id @default(uuid())
  email               String
  codeHash            String
  requestedRole       String?
  attempts            Int       @default(0)
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}
