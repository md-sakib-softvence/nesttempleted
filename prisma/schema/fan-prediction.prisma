model FanPrediction {
  id                 String               @id @default(uuid())
  fanId              String
  fan                Fan                  @relation(fields: [fanId], references: [fanId], onDelete: Cascade)
  tournamentId       String
  tournament         Tournament           @relation(fields: [tournamentId], references: [tournamentId], onDelete: Cascade)
  matchId            String
  matchTitle         String
  predictedWinnerId  String
  predictedWinnerName String
  stakeCoins         Int
  odds               Float                @default(2)
  potentialPayout    Int
  status             FanPredictionStatus  @default(PENDING)
  settledAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  coinTransactions   FanCoinTransaction[]

  @@unique([fanId, tournamentId, matchId])
  @@index([fanId, status, createdAt])
  @@index([tournamentId, matchId, status])
}

model FanCoinTransaction {
  id           String                    @id @default(uuid())
  fanId        String
  fan          Fan                       @relation(fields: [fanId], references: [fanId], onDelete: Cascade)
  predictionId String?
  prediction   FanPrediction?            @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  paymentId    String?                   @unique
  payment      Payment?                  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type         FanCoinTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  createdAt    DateTime                  @default(now())

  @@index([fanId, createdAt])
  @@index([predictionId])
}

enum FanPredictionStatus {
  PENDING
  WON
  LOST
  VOID
}

enum FanCoinTransactionType {
  SEED_CREDIT
  PURCHASE_CREDIT
  PREDICTION_STAKE
  PREDICTION_PAYOUT
  PREDICTION_REFUND
}
