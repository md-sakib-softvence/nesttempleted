model Notification {
  notificationId String             @id @default(uuid())
  status         NotificationStatus
  isRead         Boolean            @default(false)
  title          String
  description    String
  userId         String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
}

enum NotificationStatus {
  ALERT
  REPORT
  INFORMATION
}
