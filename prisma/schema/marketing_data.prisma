model MarketingDataCollection {
  marketingDataCollectionId String @id @default(uuid())

  // Relation to Fan (Optional)
  fanId String? @unique
  fan   Fan?    @relation(fields: [fanId], references: [fanId])

  // Relation to Player (Optional)
  playerId String? @unique
  player   Player? @relation(fields: [playerId], references: [playerId])

  // Relation to Employee (Optional, One-to-Many)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [employeeId])

  gamerTag             String
  favoriteGameConsole  String
  favoriteFootballGame String
  registerAs           RegisterAs
  gender               String
  ageRange             String
  globalRecord         String?
  profession           String?

  instagramLink    String?
  facebookLink     String?
  tiktokLink       String?
  xLink            String?
  youtubeLink      String?
  instagramLinkUrl String?
  facebookLinkUrl  String?
  tiktokLinkUrl    String?
  xLinkUrl         String?
  youtubeLinkUrl   String?

  parentName        String?
  parentPhoneNumber String?
  occupation        String?
  area              String?

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RegisterAs {
  FRIEND
  PLAYER
}
