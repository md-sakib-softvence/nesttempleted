model Player {
  playerId     String  @id @default(uuid())
  showPlayerId String  @unique
  firstName    String
  lastName     String
  email        String  @unique
  password     String
  phoneNumber  String
  username     String?
  gamerTag     String?
  surname      String?
  isDeleted    Boolean @default(false)

  profilePicture String?
  dateOfBirth    DateTime?

  document String[]
  status   PlayerStatus @default(ACTIVE)

  documents           PlayerDocument[]
  marketingData       MarketingDataCollection?
  registrationHistory PlayerRegistrationHistory[]
  tournamentRegistrations TournamentRegistration[]
  seriesParticipants  SeriesParticipant[]
  followers           Follower[] @relation("PlayerFollowing")
  followedBy          Follower[] @relation("PlayerFollowed")
  tickets             Ticket[]
  wallet              Wallet?
  payoutRequests      PayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gamerTag])
}

model PlayerRegistrationHistory {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [playerId])

  status RegistrationStatus
  notes  String? // Optional notes for why it was approved/rejected

  createdAt DateTime @default(now())
}

enum PlayerStatus {
  ACTIVE
  SUSPENDED
  BANNED_PERMANENTLY
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PlayerDocument {
  id         String         @id @default(uuid())
  playerId   String
  player     Player         @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  type       String         @default("Government ID")
  url        String
  uploadDate DateTime       @default(now())
  status     DocumentStatus @default(PENDING)
  notes      String?

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([playerId])
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}
